# Copy to .env.local for local work. On Vercel, add the same names under Project Settings > Environment Variables.

SUPABASE_URL=https://cmmeaztwnfdbmqjfypaw.supabase.co
# Supabase dashboard > Project Settings > API Keys > secret / service_role key. Server only, never share.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe dashboard > Developers > API keys. Start with test keys (sk_test_...).
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Password for /admin (username can be anything)
ADMIN_PASSWORD=

# Public site address, no trailing slash. Example: https://student-delivery-lyon.vercel.app
SITE_URL=http://localhost:3000
