# Copy to .env.local for local work. On Vercel, add the same names under Project Settings > Environment Variables.

# Required
SUPABASE_URL=https://cmmeaztwnfdbmqjfypaw.supabase.co
# Supabase dashboard > Project Settings > API Keys > service_role / secret key. Server only, never share.
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin (username can be anything)
ADMIN_PASSWORD=
# Public site address, no trailing slash. Example: https://delivery-lyon.vercel.app
SITE_URL=http://localhost:3000

# Optional: leave empty to take payment by hand (Revolut, Lydia, cash). Fill both to turn on card payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
